{
    "name": "full scenarion: filters SpliceInserts, SpliceSchedule and translate TimeSignals segmentation_type_id 0x30->0x22 and 0x31->0x23",
    "splice_pid": 96,
    "plugin_args": [
        "--splice-pid", "96",
        "--rules", "data/rules/rules.json"
    ],
    "monitor": true,
    "expect": {
        "exit_code": 0,
        "contains": [
            "Manipulating Segmentation Descriptor Type Id  0x00000030 ->  0x00000022",
            "Manipulating Segmentation Descriptor Type Id  0x00000031 ->  0x00000023"
        ],
        "not_contains": [
            "error loading JSON rule file",
            "No --splice-pid option provided"
        ],
        "matches": [
            "\"segmentation_type_id\"\\s*:\\s*34",
            "\"segmentation_type_id\"\\s*:\\s*35",
            "\"#name\": \"time_signal\""
        ],
        "not_matches": [
            "\"segmentation_type_id\"\\s*:\\s*48",
            "\"segmentation_type_id\"\\s*:\\s*49",
            "\"#name\": \"splice_insert\"",
            "\"#name\": \"splice_schedule\""
        ]

    }
}
